generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                              String        @id @default(cuid())
  name                            String
  username                        String        @unique(map: "users_username_key")
  /// Case-insensitive uniqueness is enforced by the users_email_lower_key expression index.
  email                           String
  passwordHash                    String?       @map("password_hash")
  role                            UserRole      @default(USER)
  promotedById                    String?       @map("promoted_by_id")
  promotedAt                      DateTime?     @map("promoted_at")
  emailVerifiedAt                 DateTime?     @map("email_verified_at")
  emailVerificationTokenHash      String?       @unique(map: "users_email_verification_token_hash_key") @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime?     @map("email_verification_token_expires_at")
  verificationEmailSentAt         DateTime?     @map("verification_email_sent_at")
  resetPasswordTokenHash          String?       @map("reset_password_token_hash")
  resetPasswordTokenExpiresAt     DateTime?     @map("reset_password_token_expires_at")
  createdAt                       DateTime      @default(now()) @map("created_at")
  updatedAt                       DateTime      @updatedAt @map("updated_at")
  gameState                       GameState?
  streak                          UserStreak?
  promotedBy                      User?         @relation("UserPromotions", fields: [promotedById], references: [id], onDelete: SetNull, map: "users_promoted_by_id_fkey")
  promotedUsers                   User[]        @relation("UserPromotions")
  scores                          Leaderboard[]
  dailyChallengeScores            DailyChallengeScore[]
  analyticsEvents                 AnonymousAnalyticsEvent[]
  accounts                        OAuthAccount[]
  puzzleImages                    PuzzleImage[]
  selectedPuzzleImageId           String?       @map("selected_puzzle_image_id")
  selectedPuzzleImage             PuzzleImage?  @relation("SelectedPuzzleImage", fields: [selectedPuzzleImageId], references: [id], onDelete: SetNull, map: "users_selected_puzzle_image_id_fkey")

  @@index([role], map: "users_role_idx")
  @@index([promotedById], map: "users_promoted_by_id_idx")
  @@index([selectedPuzzleImageId], map: "users_selected_puzzle_image_id_idx")
  @@map("users")
}

model PuzzleImage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  contentHash String   @map("content_hash")
  objectKey   String   @map("object_key")
  name        String
  contentType String   @map("content_type")
  size        Int
  width       Int
  height      Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "puzzle_images_user_id_fkey")
  selectedBy  User[]   @relation("SelectedPuzzleImage")

  @@unique([userId, contentHash], map: "puzzle_images_user_id_content_hash_key")
  @@index([userId, updatedAt], map: "puzzle_images_user_id_updated_at_idx")
  @@map("puzzle_images")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "oauth_accounts_user_id_fkey")

  @@unique([provider, providerAccountId], map: "oauth_accounts_provider_provider_account_id_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model GameState {
  id        String   @id @default(cuid())
  userId    String   @unique(map: "game_states_user_id_key") @map("user_id")
  level     Int
  board     Json
  moves     Int
  startedAt DateTime @map("started_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "game_states_user_id_fkey")

  @@map("game_states")
}

model Leaderboard {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  level        Int
  moves        Int
  timeSeconds  Int      @map("time_seconds")
  attemptType  String   @default("original") @map("attempt_type")
  replayOfId   String?  @map("replay_of_id")
  puzzleConfig Json?    @map("puzzle_config")
  completedAt  DateTime @default(now()) @map("completed_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "leaderboards_user_id_fkey")

  @@index([level, timeSeconds, moves], map: "leaderboards_level_time_seconds_moves_idx")
  @@index([replayOfId], map: "leaderboards_replay_of_id_idx")
  @@index([userId, completedAt], map: "leaderboards_user_id_completed_at_idx")
  @@map("leaderboards")
}

model DailyChallengeScore {
  id            String   @id @default(cuid())
  challengeDate String   @map("challenge_date")
  userId        String   @map("user_id")
  level         Int
  moves         Int
  timeSeconds   Int      @map("time_seconds")
  puzzleConfig  Json?    @map("puzzle_config")
  completedAt   DateTime @default(now()) @map("completed_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "daily_challenge_scores_user_id_fkey")

  @@unique([challengeDate, userId], map: "daily_challenge_scores_challenge_date_user_id_key")
  @@index([challengeDate, timeSeconds, moves], map: "daily_challenge_scores_date_time_moves_idx")
  @@index([userId, completedAt], map: "daily_challenge_scores_user_completed_at_idx")
  @@map("daily_challenge_scores")
}

model UserStreak {
  id                      String   @id @default(cuid())
  userId                  String   @unique(map: "user_streaks_user_id_key") @map("user_id")
  currentStreak           Int      @default(0) @map("current_streak")
  longestStreak           Int      @default(0) @map("longest_streak")
  lastCompletionLocalDate String?  @map("last_completion_local_date")
  lastCompletionTimeZone  String?  @map("last_completion_time_zone")
  celebratedMilestones    Int[]    @default([]) @map("celebrated_milestones")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_streaks_user_id_fkey")

  @@index([userId, lastCompletionLocalDate], map: "user_streaks_user_id_last_completion_local_date_idx")
  @@map("user_streaks")
}

model AnonymousAnalyticsEvent {
  id                String   @id @default(cuid())
  anonymousId       String   @map("anonymous_player_id")
  userId            String?  @map("user_id")
  sessionId         String   @map("session_id")
  eventName         String   @map("event_name")
  signedIn          Boolean  @default(false) @map("signed_in")
  level             Int?
  puzzleSize        String?  @map("puzzle_size")
  moveCount         Int?     @map("move_count")
  timerValueMs      Int?     @map("timer_value_ms")
  occurredAt        DateTime @map("occurred_at")
  pathname          String?
  referrer          String?
  screenWidth       Int?     @map("screen_width")
  screenHeight      Int?     @map("screen_height")
  userAgent         String?  @map("user_agent")
  deviceType        String?  @map("device_type")
  browser           String?
  operatingSystem   String?  @map("operating_system")
  ipAddress         String?  @map("ip_address")
  country           String?
  city              String?
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull, map: "anonymous_analytics_events_user_id_fkey")

  @@index([anonymousId, occurredAt], map: "anonymous_analytics_events_player_occurred_at_idx")
  @@index([eventName, occurredAt], map: "anonymous_analytics_events_name_occurred_at_idx")
  @@index([sessionId], map: "anonymous_analytics_events_session_id_idx")
  @@index([userId, occurredAt], map: "anonymous_analytics_events_user_id_occurred_at_idx")
  @@map("anonymous_analytics_events")
}
