# Database
DATABASE_URL="postgresql://sliding_tiles:sliding_tiles@localhost:5432/sliding_tiles?schema=public"
DOCKER_DATABASE_URL="postgresql://sliding_tiles:sliding_tiles@postgres:5432/sliding_tiles?schema=public"

# Authentication
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Local development
WEB_PORT=3000
API_PORT=4001
NEXT_ALLOWED_DEV_ORIGINS="192.168.1.100"
API_CORS_ORIGINS="http://localhost:3000,http://192.168.1.100:3000"

# Service URLs
API_BASE_URL="http://localhost:4001/api"
DOCKER_API_BASE_URL="http://localhost:4001/api"
PUBLIC_API_BASE_URL="http://localhost:4001"
WEB_BASE_URL="http://localhost:3000"

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sliding Tiles <onboarding@resend.dev>"

# Runtime
RUN_MIGRATIONS=true
